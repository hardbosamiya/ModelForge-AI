# ==========================
# Server Configuration
# ==========================
NODE_ENV=development
PORT=5000

# ==========================
# MongoDB Configuration
# ==========================
MONGODB_URI=mongodb://localhost:27017/ModelForge-AI

# ==========================
# JWT Configuration
# ==========================
JWT_SECRET=modelforge_dev_secret_change_me
JWT_EXPIRES_IN=7d

# ==========================
# CORS / Frontend
# ==========================
FRONTEND_URL=http://localhost:5173

# ==========================
# File Upload Configuration
# ==========================
UPLOAD_PATH=src/uploads
MAX_FILE_SIZE=104857600

# ==========================
# Django ML API
# All Django ML routes are mounted under /api/ml/, and the Node service
# clients append relative paths (e.g. /datasets/upload/, /train/), so the
# base URL must include the /api/ml prefix.
# ==========================
DJANGO_API_URL=http://localhost:8000/api/ml

# Absolute path to the Django media directory. Training writes model .pkl
# files under <DJANGO_MEDIA_PATH>/models/... and reads their size back, so
# Node and Django must resolve the same folder on this machine.
DJANGO_MEDIA_PATH=D:/hard/ModelForge-AI/ModelForge-AI/ml-service/media

# ==========================
# Logging Configuration
# ==========================
LOG_LEVEL=info
